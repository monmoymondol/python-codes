# MAIN MENU
# ══════════════════════════════════════════════════════════════════════════════

def main_menu():
    data = load_data()
    while True:
        header("MAIN MENU")
        total = len(data["students"])
        print(c(f"  Students in database: {total}\n", Color.CYAN))
        menu = [
            ("1", "➕  Add New Student"),
            ("2", "📋  View All Students"),
            ("3", "🔍  Search Student"),
            ("4", "✏️   Update Student"),
            ("5", "🗑️   Delete Student"),
            ("6", "📊  Statistics & Report"),
            ("7", "🏆  Top Students Leaderboard"),
            ("0", "🚪  Exit"),
        ]
        for key, label in menu:
            print(f"   {c(key, Color.CYAN + Color.BOLD)}.  {label}")

        divider()
        choice = input(c("\n  Enter choice: ", Color.YELLOW)).strip()

        if   choice == "1": add_student(data)
        elif choice == "2": view_all_students(data)
        elif choice == "3": search_student(data)
        elif choice == "4": update_student(data)
        elif choice == "5": delete_student(data)
        elif choice == "6": statistics(data)
        elif choice == "7": top_students(data)
        elif choice == "0":
            clear()
            print(c("\n  👋  Goodbye! Data saved.\n", Color.GREEN + Color.BOLD))
            sys.exit(0)
        else:
            print(c("  ✖  Invalid choice. Try again.", Color.RED))
            pause()

        # Reload data after each operation
        data = load_data()


if __name__ == "__main__":
    main_menu()

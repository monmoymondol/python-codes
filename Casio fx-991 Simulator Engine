if __name__ == "__main__":
    calc = CasioSimulator()

    print("--- Testing Casio fx-991 Engine ---")

    # Calculus Test
    print("\n1. Calculus:")
    # Integral of x^2 from 0 to 3
    integral = calc.definite_integral(lambda x: x**2, 0, 3)
    print(f"Integral of x^2 from 0 to 3: {integral:.4f}")
    
    # Derivative of x^2 at x = 3
    derivative = calc.numerical_derivative(lambda x: x**2, 3)
    print(f"Derivative of x^2 at x = 3: {derivative:.4f}")

    # Equation Solver Test
    print("\n2. Equation Solver:")
    # 2x + 3y = 8 and 3x - y = 1
    coeffs = [[2, 3], [3, -1]]
    consts = [8, 1]
    ans = calc.solve_simultaneous(coeffs, consts)
    print(f"Simultaneous (2x+3y=8, 3x-y=1): X={ans[0]:.2f}, Y={ans[1]:.2f}")
    
    # Roots of x^2 - 5x + 6 = 0
    roots = calc.solve_polynomial([1, -5, 6])
    print(f"Polynomial Roots of x^2 - 5x + 6: {roots}")

    # Distributions Test
    print("\n3. Distributions:")
    prob = calc.binomial_pmf(k=5, n=10, p=0.5)
    print(f"Binomial Probability (5 successes in 10 trials, p=0.5): {prob:.4f}")

    # MathBox Test
    print("\n4. MathBox:")
    print(f"Rolling 3 six-sided dice: {calc.roll_dice(6, 3)}")

import json
import hashlib
import os
import random
from datetime import datetime

# ==================== Account Class ====================
class Account:
    """Represents a single bank account."""

    def __init__(self, account_number, name, password, balance=0.0):
        self.account_number = account_number
        self.name = name
        # Hash the password using SHA-256
        self.password_hash = hashlib.sha256(password.encode()).hexdigest()
        self.balance = balance

    def verify_password(self, password):
        """Check if the provided password matches the stored hash."""
        return self.password_hash == hashlib.sha256(password.encode()).hexdigest()

    def deposit(self, amount):
        """Add money to the account."""
        if amount > 0:
            self.balance += amount
            return True
        return False

    def withdraw(self, amount):
        """Withdraw money if sufficient balance exists."""
        if 0 < amount <= self.balance:
            self.balance -= amount
            return True
        return False

    def to_dict(self):
        """Convert account object to dictionary for JSON serialization."""
        return {
            "account_number": self.account_number,
            "name": self.name,
            "password_hash": self.password_hash,
            "balance": self.balance
        }

    @staticmethod
    def from_dict(data):
        """Create an Account object from a dictionary."""
        acc = Account(
            account_number=data["account_number"],
            name=data["name"],
            password="",          # dummy password, we'll set the hash directly
            balance=data["balance"]
        )
        acc.password_hash = data["password_hash"]
        return acc


# ==================== Bank Class ====================
class Bank:
    """Manages all bank accounts and transactions."""

    ACCOUNTS_FILE = "accounts.json"
    TRANSACTIONS_FILE = "transactions.json"

    def __init__(self):
        self.accounts = {}        # account_number -> Account object
        self.transactions = []     # list of transaction records
        self.current_account = None   # logged-in user
        self.load_data()

    # -------------------- Data Persistence --------------------
    def load_data(self):
        """Load accounts and transactions from JSON files."""
        # Load accounts
        if os.path.exists(self.ACCOUNTS_FILE):
            with open(self.ACCOUNTS_FILE, "r") as f:
                try:
                    data = json.load(f)
                    for acc_data in data:
                        acc = Account.from_dict(acc_data)
                        self.accounts[acc.account_number] = acc
                except json.JSONDecodeError:
                    pass  # file empty or corrupt – start fresh

        # Load transactions
        if os.path.exists(self.TRANSACTIONS_FILE):
            with open(self.TRANSACTIONS_FILE, "r") as f:
                try:
                    self.transactions = json.load(f)
                except json.JSONDecodeError:
                    self.transactions = []

    def save_data(self):
        """Save accounts and transactions to JSON files."""
        # Save accounts
        accounts_list = [acc.to_dict() for acc in self.accounts.values()]
        with open(self.ACCOUNTS_FILE, "w") as f:
            json.dump(accounts_list, f, indent=4)

        # Save transactions
        with open(self.TRANSACTIONS_FILE, "w") as f:
            json.dump(self.transactions, f, indent=4)

    # -------------------- Helper Methods --------------------
    def generate_account_number(self):
        """Generate a unique 6-digit account number."""
        while True:
            acc_num = str(random.randint(100000, 999999))
            if acc_num not in self.accounts:
                return acc_num

    def log_transaction(self, acc_num, trans_type, amount, related_acc=None):
        """Record a transaction with timestamp."""
        transaction = {
            "account": acc_num,
            "type": trans_type,
            "amount": amount,
            "related_account": related_acc,
            "timestamp": datetime.now().isoformat()
        }
        self.transactions.append(transaction)

    # -------------------- Core Banking Operations --------------------
    def create_account(self, name, password):
        """Create a new account and save data."""
        acc_num = self.generate_account_number()
        account = Account(acc_num, name, password)
        self.accounts[acc_num] = account
        self.save_data()
        return acc_num

    def login(self, account_number, password):
        """Authenticate user and set current account."""
        acc = self.accounts.get(account_number)
        if acc and acc.verify_password(password):
            self.current_account = acc
            return True
        return False

    def logout(self):
        """Log out the current user."""
        self.current_account = None

    def deposit(self, amount):
        """Deposit money into the logged-in account."""
        if not self.current_account:
            return False, "No account logged in."
        if self.current_account.deposit(amount):
            self.log_transaction(self.current_account.account_number, "deposit", amount)
            self.save_data()
            return True, f"Deposited ${amount:.2f}. New balance: ${self.current_account.balance:.2f}"
        return False, "Invalid deposit amount."

    def withdraw(self, amount):
        """Withdraw money from the logged-in account."""
        if not self.current_account:
            return False, "No account logged in."
        if self.current_account.withdraw(amount):
            self.log_transaction(self.current_account.account_number, "withdraw", amount)
            self.save_data()
            return True, f"Withdrew ${amount:.2f}. New balance: ${self.current_account.balance:.2f}"
        return False, "Insufficient balance or invalid amount."

    def transfer(self, target_acc_num, amount):
        """Transfer money from logged-in account to another account."""
        if not self.current_account:
            return False, "No account logged in."
        if amount <= 0:
            return False, "Transfer amount must be positive."

        target_acc = self.accounts.get(target_acc_num)
        if not target_acc:
            return False, "Target account does not exist."

        if self.current_account.balance < amount:
            return False, "Insufficient balance."

        # Perform transfer
        self.current_account.withdraw(amount)
        target_acc.deposit(amount)

        # Log transaction for both accounts
        self.log_transaction(self.current_account.account_number, "transfer_out", amount, target_acc_num)
        self.log_transaction(target_acc_num, "transfer_in", amount, self.current_account.account_number)

        self.save_data()
        return True, f"Transferred ${amount:.2f} to account {target_acc_num}. New balance: ${self.current_account.balance:.2f}"

    def get_balance(self):
        """Return current balance of logged-in account."""
        if self.current_account:
            return self.current_account.balance
        return None

    def get_transaction_history(self, account_number=None):
        """Return transaction history for a given account (or current if none provided)."""
        if account_number is None:
            if self.current_account:
                account_number = self.current_account.account_number
            else:
                return []
        # Filter transactions where the account is involved (either main or related)
        history = [t for t in self.transactions if t["account"] == account_number or t.get("related_account") == account_number]
        # Sort by timestamp (most recent first)
        history.sort(key=lambda x: x["timestamp"], reverse=True)
        return history


# ==================== Main Program ====================
def main():
    bank = Bank()
    print("=" * 50)
    print("       Welcome to the Bank Management System")
    print("=" * 50)

    while True:
        # Main menu (logged out)
        if bank.current_account is None:
            print("\n--- Main Menu ---")
            print("1. Create Account")
            print("2. Login")
            print("3. Exit")
            choice = input("Enter your choice: ")

            if choice == "1":
                name = input("Enter your full name: ")
                password = input("Choose a password: ")
                acc_num = bank.create_account(name, password)
                print(f"\nAccount created successfully! Your account number is: {acc_num}")
                print("Please remember your account number and password for login.")

            elif choice == "2":
                acc_num = input("Enter account number: ")
                password = input("Enter password: ")
                if bank.login(acc_num, password):
                    print(f"\nLogin successful! Welcome, {bank.current_account.name}.")
                else:
                    print("\nInvalid account number or password.")

            elif choice == "3":
                print("\nThank you for using the Bank Management System. Goodbye!")
                break
            else:
                print("\nInvalid choice. Please try again.")

        # Logged-in menu
        else:
            print(f"\n--- Logged in as {bank.current_account.name} (Acc: {bank.current_account.account_number}) ---")
            print("1. Deposit")
            print("2. Withdraw")
            print("3. Transfer")
            print("4. Check Balance")
            print("5. Transaction History")
            print("6. Logout")
            choice = input("Enter your choice: ")

            if choice == "1":
                try:
                    amount = float(input("Enter amount to deposit: $"))
                    success, message = bank.deposit(amount)
                    print(message)
                except ValueError:
                    print("Invalid amount. Please enter a number.")

            elif choice == "2":
                try:
                    amount = float(input("Enter amount to withdraw: $"))
                    success, message = bank.withdraw(amount)
                    print(message)
                except ValueError:
                    print("Invalid amount. Please enter a number.")

            elif choice == "3":
                target = input("Enter target account number: ")
                try:
                    amount = float(input("Enter amount to transfer: $"))
                    success, message = bank.transfer(target, amount)
                    print(message)
                except ValueError:
                    print("Invalid amount. Please enter a number.")

            elif choice == "4":
                balance = bank.get_balance()
                print(f"Your current balance: ${balance:.2f}")

            elif choice == "5":
                history = bank.get_transaction_history()
                if not history:
                    print("No transactions found.")
                else:
                    print("\n--- Transaction History ---")
                    for t in history:
                        # Format nicely
                        if t["type"] in ("deposit", "withdraw"):
                            print(f"{t['timestamp'][:19]} - {t['type'].capitalize()}: ${t['amount']:.2f}")
                        elif t["type"] == "transfer_out":
                            print(f"{t['timestamp'][:19]} - Transfer OUT to {t['related_account']}: ${t['amount']:.2f}")
                        elif t["type"] == "transfer_in":
                            print(f"{t['timestamp'][:19]} - Transfer IN from {t['related_account']}: ${t['amount']:.2f}")

            elif choice == "6":
                bank.logout()
                print("Logged out successfully.")

            else:
                print("Invalid choice. Please try again.")


if __name__ == "__main__":
    main()

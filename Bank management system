import random
import string
from datetime import datetime, timedelta
from typing import Optional

# ─── CONFIG ───────────────────────────────────────────────────────────────────
DATA_FILE = "bank_data.json"
ADMIN_PASSWORD_HASH = hashlib.sha256("admin123".encode()).hexdigest()

INTEREST_RATES = {
    "savings": 4.0,        # 4% per year
    "current": 0.0,        # No interest
    "fixed_deposit": 7.5,  # 7.5% per year
}

LOAN_INTEREST_RATE = 10.0  # 10% per year


# ─── UTILITY HELPERS ──────────────────────────────────────────────────────────
def hash_password(password: str) -> str:
    return hashlib.sha256(password.encode()).hexdigest()


def generate_account_number() -> str:
    return "ACC" + "".join(random.choices(string.digits, k=9))


def generate_loan_id() -> str:
    return "LN" + "".join(random.choices(string.digits, k=8))


def get_timestamp() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def clear_screen():
    os.system("cls" if os.name == "nt" else "clear")


def print_header(title: str):
    width = 60
    print("\n" + "═" * width)
    print(f"  {title}")
    print("═" * width)


def print_success(msg: str):
    print(f"\n  ✔  {msg}")


def print_error(msg: str):
    print(f"\n  ✘  {msg}")


def print_info(msg: str):
    print(f"     {msg}")


def pause():
    input("\n  Press Enter to continue...")


def format_currency(amount: float) -> str:
    return f"৳{amount:,.2f}"


# ─── DATA PERSISTENCE ─────────────────────────────────────────────────────────
def load_data() -> dict:
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r") as f:
            return json.load(f)
    return {"accounts": {}, "loans": {}}


def save_data(data: dict):
    with open(DATA_FILE, "w") as f:
        json.dump(data, f, indent=2)


# ─── ACCOUNT CLASS ────────────────────────────────────────────────────────────
class Account:
    def __init__(
        self,
        account_number: str,
        owner_name: str,
        email: str,
        phone: str,
        password_hash: str,
        account_type: str,
        balance: float = 0.0,
        transactions: list = None,
        created_at: str = None,
        is_active: bool = True,
        fixed_deposit_maturity: str = None,
    ):
        self.account_number = account_number
        self.owner_name = owner_name
        self.email = email
        self.phone = phone
        self.password_hash = password_hash
        self.account_type = account_type
        self.balance = balance
        self.transactions = transactions or []
        self.created_at = created_at or get_timestamp()
        self.is_active = is_active
        self.fixed_deposit_maturity = fixed_deposit_maturity

    def to_dict(self) -> dict:
        return self.__dict__

    @classmethod
    def from_dict(cls, d: dict) -> "Account":
        return cls(**d)

    def add_transaction(self, txn_type: str, amount: float, description: str, balance_after: float):
        self.transactions.append({
            "id": "TXN" + "".join(random.choices(string.digits, k=8)),
            "type": txn_type,
            "amount": amount,
            "description": description,
            "balance_after": balance_after,
            "timestamp": get_timestamp(),
        })

    def deposit(self, amount: float, description: str = "Deposit") -> bool:
        if amount <= 0:
            return False
        self.balance += amount
        self.add_transaction("CREDIT", amount, description, self.balance)
        return True

    def withdraw(self, amount: float, description: str = "Withdrawal") -> tuple:
        if amount <= 0:
            return False, "Amount must be positive."
        if amount > self.balance:
            return False, "Insufficient funds."
        if not self.is_active:
            return False, "Account is inactive."
        self.balance -= amount
        self.add_transaction("DEBIT", amount, description, self.balance)
        return True, "Success"

    def apply_interest(self):
        rate = INTEREST_RATES.get(self.account_type, 0.0)
        if rate > 0:
            interest = round(self.balance * (rate / 100) / 12, 2)  # monthly
            if interest > 0:
                self.balance += interest
                self.add_transaction("CREDIT", interest, f"Monthly Interest ({rate}% p.a.)", self.balance)
                return interest
        return 0.0


# ─── LOAN CLASS ───────────────────────────────────────────────────────────────
class Loan:
    def __init__(
        self,
        loan_id: str,
        account_number: str,
        principal: float,
        interest_rate: float,
        term_months: int,
        amount_paid: float = 0.0,
        status: str = "active",
        created_at: str = None,
    ):
        self.loan_id = loan_id
        self.account_number = account_number
        self.principal = principal
        self.interest_rate = interest_rate
        self.term_months = term_months
        self.amount_paid = amount_paid
        self.status = status
        self.created_at = created_at or get_timestamp()

    @property
    def total_payable(self) -> float:
        return round(self.principal * (1 + self.interest_rate / 100 * self.term_months / 12), 2)

    @property
    def outstanding(self) -> float:
        return round(max(self.total_payable - self.amount_paid, 0), 2)

    @property
    def monthly_emi(self) -> float:
        return round(self.total_payable / self.term_months, 2)

    def to_dict(self) -> dict:
        return self.__dict__

    @classmethod
    def from_dict(cls, d: dict) -> "Loan":
        return cls(**d)


# ─── BANK CLASS ───────────────────────────────────────────────────────────────
class Bank:
    def __init__(self):
        raw = load_data()
        self.accounts: dict[str, Account] = {
            k: Account.from_dict(v) for k, v in raw.get("accounts", {}).items()
        }
        self.loans: dict[str, Loan] = {
            k: Loan.from_dict(v) for k, v in raw.get("loans", {}).items()
        }

    def save(self):
        save_data({
            "accounts": {k: v.to_dict() for k, v in self.accounts.items()},
            "loans": {k: v.to_dict() for k, v in self.loans.items()},
        })

    def find_account(self, account_number: str) -> Optional[Account]:
        return self.accounts.get(account_number)

    def authenticate(self, account_number: str, password: str) -> Optional[Account]:
        acc = self.find_account(account_number)
        if acc and acc.password_hash == hash_password(password):
            return acc
        return None

    def create_account(
        self, name: str, email: str, phone: str, password: str, account_type: str, initial_deposit: float = 0.0
    ) -> Account:
        acc_num = generate_account_number()
        while acc_num in self.accounts:
            acc_num = generate_account_number()

        maturity = None
        if account_type == "fixed_deposit":
            maturity = (datetime.now() + timedelta(days=365)).strftime("%Y-%m-%d")

        acc = Account(
            account_number=acc_num,
            owner_name=name,
            email=email,
            phone=phone,
            password_hash=hash_password(password),
            account_type=account_type,
            balance=0.0,
            fixed_deposit_maturity=maturity,
        )
        if initial_deposit > 0:
            acc.deposit(initial_deposit, "Initial Deposit")

        self.accounts[acc_num] = acc
        self.save()
        return acc

    def transfer(self, from_acc: Account, to_acc_num: str, amount: float) -> tuple:
        to_acc = self.find_account(to_acc_num)
        if not to_acc:
            return False, "Destination account not found."
        if not to_acc.is_active:
            return False, "Destination account is inactive."
        if from_acc.account_number == to_acc_num:
            return False, "Cannot transfer to the same account."

        ok, msg = from_acc.withdraw(amount, f"Transfer to {to_acc_num}")
        if not ok:
            return False, msg
        to_acc.deposit(amount, f"Transfer from {from_acc.account_number}")
        self.save()
        return True, "Transfer successful."

    def apply_for_loan(self, acc: Account, principal: float, term_months: int) -> tuple:
        # Check if user already has active loan
        existing = [l for l in self.loans.values() if l.account_number == acc.account_number and l.status == "active"]
        if existing:
            return False, "You already have an active loan."
        if principal <= 0:
            return False, "Invalid loan amount."
        if term_months not in [6, 12, 24, 36, 60]:
            return False, "Invalid term. Choose from 6, 12, 24, 36, or 60 months."

        loan_id = generate_loan_id()
        loan = Loan(
            loan_id=loan_id,
            account_number=acc.account_number,
            principal=principal,
            interest_rate=LOAN_INTEREST_RATE,
            term_months=term_months,
        )
        acc.deposit(principal, f"Loan Disbursement ({loan_id})")
        self.loans[loan_id] = loan
        self.save()
        return True, loan

    def repay_loan(self, acc: Account, loan_id: str, amount: float) -> tuple:
        loan = self.loans.get(loan_id)
        if not loan or loan.account_number != acc.account_number:
            return False, "Loan not found."
        if loan.status != "active":
            return False, "Loan is already closed."
        if amount > loan.outstanding:
            amount = loan.outstanding  # cap repayment
        ok, msg = acc.withdraw(amount, f"Loan Repayment ({loan_id})")
        if not ok:
            return False, msg
        loan.amount_paid += amount
        if loan.outstanding <= 0:
            loan.status = "closed"
        self.save()
        return True, f"Repayment of {format_currency(amount)} successful."



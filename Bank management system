def admin_list_accounts():
    print_header("ALL ACCOUNTS")
    if not bank.accounts:
        print_info("No accounts found.")
        pause()
        return
    print(f"\n  {'Account No':<14} {'Name':<22} {'Type':<16} {'Balance':>12}  Status")
    print("  " + "-" * 75)
    for acc in bank.accounts.values():
        status = "Active" if acc.is_active else "Inactive"
        print(
            f"  {acc.account_number:<14} {acc.owner_name[:20]:<22} "
            f"{acc.account_type.replace('_',' ').title():<16} "
            f"{format_currency(acc.balance):>12}  {status}"
        )
    pause()


def admin_search_account():
    print_header("SEARCH ACCOUNT")
    query = input("  Enter Account No or Name: ").strip().lower()
    results = [
        a for a in bank.accounts.values()
        if query in a.account_number.lower() or query in a.owner_name.lower()
    ]
    if not results:
        print_info("No matching accounts found.")
    else:
        for acc in results:
            print(f"\n  Account No: {acc.account_number}")
            print_info(f"Name     : {acc.owner_name}")
            print_info(f"Type     : {acc.account_type.replace('_', ' ').title()}")
            print_info(f"Balance  : {format_currency(acc.balance)}")
            print_info(f"Status   : {'Active' if acc.is_active else 'Inactive'}")
            print_info(f"Email    : {acc.email}")
            print_info(f"Phone    : {acc.phone}")
    pause()


def admin_toggle_account():
    print_header("ACTIVATE / DEACTIVATE ACCOUNT")
    acc_num = input("  Account Number: ").strip().upper()
    acc = bank.find_account(acc_num)
    if not acc:
        print_error("Account not found.")
        pause()
        return
    current_status = "Active" if acc.is_active else "Inactive"
    new_status = not acc.is_active
    confirm = input(
        f"  Account is currently {current_status}. {'Deactivate' if acc.is_active else 'Activate'}? [y/n]: "
    ).strip().lower()
    if confirm == "y":
        acc.is_active = new_status
        bank.save()
        print_success(f"Account {'activated' if new_status else 'deactivated'} successfully.")
    else:
        print_info("No changes made.")
    pause()


def admin_view_loans():
    print_header("ALL LOANS")
    active_loans = [l for l in bank.loans.values() if l.status == "active"]
    if not active_loans:
        print_info("No active loans.")
        pause()
        return
    print(f"\n  {'Loan ID':<12} {'Account':<14} {'Principal':>12} {'Outstanding':>13} {'EMI':>10}  Term")
    print("  " + "-" * 75)
    for loan in active_loans:
        print(
            f"  {loan.loan_id:<12} {loan.account_number:<14} "
            f"{format_currency(loan.principal):>12} "
            f"{format_currency(loan.outstanding):>13} "
            f"{format_currency(loan.monthly_emi):>10}  {loan.term_months}m"
        )
    pause()


def admin_apply_all_interest():
    print_header("APPLY INTEREST TO ALL ACCOUNTS")
    confirm = input("  Apply monthly interest to all eligible accounts? [y/n]: ").strip().lower()
    if confirm != "y":
        print_info("Cancelled.")
        pause()
        return
    count = 0
    total_interest = 0.0
    for acc in bank.accounts.values():
        if acc.is_active:
            interest = acc.apply_interest()
            if interest > 0:
                count += 1
                total_interest += interest
    bank.save()
    print_success(f"Interest applied to {count} accounts.")
    print_info(f"Total Interest Paid: {format_currency(total_interest)}")
    pause()


def admin_delete_account():
    print_header("DELETE ACCOUNT")
    acc_num = input("  Account Number to Delete: ").strip().upper()
    acc = bank.find_account(acc_num)
    if not acc:
        print_error("Account not found.")
        pause()
        return
    if acc.balance > 0:
        print_error(f"Cannot delete account with balance {format_currency(acc.balance)}. Withdraw funds first.")
        pause()
        return
    active_loans = [l for l in bank.loans.values() if l.account_number == acc_num and l.status == "active"]
    if active_loans:
        print_error("Cannot delete account with active loans.")
        pause()
        return
    confirm = input(f"  Delete account {acc_num} ({acc.owner_name})? This is IRREVERSIBLE. [yes]: ").strip().lower()
    if confirm == "yes":
        del bank.accounts[acc_num]
        bank.save()
        print_success("Account deleted successfully.")
    else:
        print_info("Deletion cancelled.")
    pause()



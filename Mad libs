HISTORY_FILE = "mad_libs_history.json"

# ─── History ──────────────────────────────────────────────────────────────────
def load_history():
    if os.path.exists(HISTORY_FILE):
        with open(HISTORY_FILE) as f:
            return json.load(f)
    return []

def save_history(entry):
    history = load_history()
    history.append(entry)
    with open(HISTORY_FILE, "w") as f:
        json.dump(history, f, indent=4)

# ─── Core: Play a Story ───────────────────────────────────────────────────────
def play_story(story, mode="normal"):
    header(story["title"])

    answers = {}
    print(c("  Fill in the blanks below:\n", Color.WHITE))

    if mode == "random":
        # Auto-fill with funny random words
        word_pools = {
            "adjective": ["slimy","enormous","purple","furious","bouncy","invisible","crispy"],
            "verb_past": ["exploded","sneezed","moonwalked","melted","yodeled","somersaulted"],
            "verb_ing":  ["juggling","snoring","tap-dancing","hiccupping","waddling"],
            "animal":    ["penguin","capybara","flamingo","narwhal","axolotl","platypus"],
            "food":      ["spaghetti","bubble wrap","tacos","mystery soup","expired cheese"],
            "number":    ["42","7","1000","3.14","99"],
            "color":     ["neon green","polka-dot","transparent","rainbow","beige"],
            "noun":      ["spatula","accordion","rubber duck","trampoline","encyclopedia"],
            "exclamation":["Bazinga","Oh Noodles","Yikes","Great Googly Moogly","Bananas"],
            "emotion":   ["confusion","absolute joy","mild panic","pure silliness","wonder"],
            "body_part": ["elbow","left nostril","kneecap","earlobe","pinky toe"],
            "name":      ["Bob","Zara","Professor Quack","Maximilian","Bloop"],
            "city":      ["Bananapolis","New Wobble","Quacktown","Fizzburg"],
            "subject":   ["Underwater Basket-Weaving","Advanced Napping","Goat Studies"],
        }
        for key, hint in story["blanks"]:
            best = "name"
            for pool_key in word_pools:
                if pool_key in key or pool_key in hint.lower():
                    best = pool_key
                    break
            answers[key] = random.choice(word_pools[best])
            print(f"  {c(hint.capitalize()+':', Color.CYAN):<40} {c(answers[key], Color.MAGENTA)}")
    else:
        for key, hint in story["blanks"]:
            while True:
                val = input(c(f"  {hint.capitalize()}: ", Color.CYAN)).strip()
                if val:
                    answers[key] = val
                    break
                print(c("  ✖  Please enter a value.", Color.RED))

    # Render story
    result = story["template"].format(**answers)

    print()
    divider("═")
    print(c(f"  🎉  {story['title']}", Color.YELLOW + Color.BOLD))
    divider("═")
    print(c(result, Color.WHITE))
    divider()

    # Save to history
    save_history({
        "title":    story["title"],
        "date":     datetime.now().strftime("%Y-%m-%d %H:%M"),
        "answers":  answers,
        "story":    result.strip()
    })

    # Option to export
    export = input(c("  Save this story to a text file? (y/n): ", Color.YELLOW)).strip().lower()
    if export == "y":
        fname = f"madlib_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt"
        with open(fname, "w") as f:
            f.write(f"{story['title']}\n{'='*60}\n{result}\n")
            f.write("\nYour answers:\n")
            for key, val in answers.items():
                f.write(f"  {key}: {val}\n")
        print(c(f"  ✔  Saved as '{fname}'", Color.GREEN))

    pause()

# ─── View History ─────────────────────────────────────────────────────────────
def view_history():
    header("STORY HISTORY")
    history = load_history()
    if not history:
        print(c("  No stories generated yet!", Color.YELLOW))
        pause()
        return

    print(c(f"  {len(history)} stories generated so far:\n", Color.CYAN))
    for i, entry in enumerate(reversed(history[-10:]), 1):
        print(f"  {c(str(i), Color.MAGENTA)}. {c(entry['title'], Color.WHITE + Color.BOLD)}  "
              f"— {c(entry['date'], Color.YELLOW)}")
        preview = entry["story"][:120].replace("\n", " ").strip()
        print(f"     {c(preview + '...', Color.CYAN)}")
        print()
    divider()
    pause()

# ─── Choose Story ─────────────────────────────────────────────────────────────
def choose_story():
    header("CHOOSE A STORY")
    for i, story in enumerate(STORIES, 1):
        print(f"  {c(str(i), Color.CYAN + Color.BOLD)}.  {story['title']}")
        blanks_preview = ", ".join(h for _, h in story["blanks"][:4]) + "..."
        print(f"      {c('Needs:', Color.YELLOW)} {blanks_preview}\n")
    print(f"  {c('R', Color.MAGENTA + Color.BOLD)}.  🎲 Random Story")
    divider()

    while True:
        raw = input(c("  Your choice: ", Color.YELLOW)).strip().upper()
        if raw == "R":
            return random.choice(STORIES)
        try:
            idx = int(raw)
            if 1 <= idx <= len(STORIES):
                return STORIES[idx - 1]
        except ValueError:
            pass
        print(c("  ✖  Invalid choice.", Color.RED))

# ─── Main Menu ────────────────────────────────────────────────────────────────
def main():
    while True:
        header("MAIN MENU")
        print(c("""
  1.  ✍️   Play Mad Libs  (you fill the blanks)
  2.  🎲  Random Mode    (auto-filled with funny words)
  3.  📜  View History
  0.  🚪  Exit
""", Color.WHITE))
        divider()
        choice = input(c("  Enter choice: ", Color.YELLOW)).strip()

        if choice == "1":
            story = choose_story()
            play_story(story, mode="normal")
        elif choice == "2":
            story = choose_story()
            play_story(story, mode="random")
        elif choice == "3":
            view_history()
        elif choice == "0":
            clear()
            print(c("\n  👋  Thanks for playing Mad Libs! Goodbye!\n", Color.GREEN + Color.BOLD))
            break
        else:
            print(c("  ✖  Invalid choice.", Color.RED))
            pause()

if __name__ == "__main__":
    main()

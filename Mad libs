# ─── ANSI Colors ──────────────────────────────────────────────────────────────
class Color:
    RESET   = "\033[0m"
    BOLD    = "\033[1m"
    RED     = "\033[91m"
    GREEN   = "\033[92m"
    YELLOW  = "\033[93m"
    BLUE    = "\033[94m"
    CYAN    = "\033[96m"
    MAGENTA = "\033[95m"
    WHITE   = "\033[97m"

def c(text, color): return f"{color}{text}{Color.RESET}"
def clear(): os.system("cls" if os.name == "nt" else "clear")
def pause(): input(c("\n  Press Enter to continue...", Color.YELLOW))
def divider(ch="─", n=62): print(c(ch * n, Color.BLUE))

def header(title=""):
    clear()
    divider("═")
    print(c("  📖  MAD LIBS GENERATOR", Color.CYAN + Color.BOLD))
    divider("═")
    if title:
        print(c(f"  ▸  {title}", Color.YELLOW + Color.BOLD))
        divider()

